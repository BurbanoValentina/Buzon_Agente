# ==============================================================================
# BUZÓN UCC — Plantilla de Variables de Entorno (NO SUBIR CREDENCIALES A GIT)
# Copia este archivo a .env y llena los valores reales
# ==============================================================================

# Backend Port
PORT=8081

# Supabase PostgreSQL (24/7 en la nube)
DATABASE_URL=jdbc:postgresql://db.<PROJECT-REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tu-contraseña-de-supabase

# Supabase API & Storage (bucket 'evidencias')
SUPABASE_URL=https://<PROJECT-REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-anon-publishable-key
SUPABASE_SECRET_KEY=tu-service-role-secret-key
SUPABASE_JWKS_URL=https://<PROJECT-REF>.supabase.co/auth/v1/.well-known/jwks.json

# Bot de Telegram
TELEGRAM_ENABLED=true
TELEGRAM_LONG_POLLING=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ENCRYPTION_SECRET=

# Inteligencia Artificial
AI_PROVIDER=simulation

# Frontend (para despliegue en Vercel)
# VITE_API_URL=https://buzon-ucc-backend.onrender.com
