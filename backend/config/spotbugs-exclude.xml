<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.ucc\.complaints\.model\.(AuditEntry|SecurityChallenge)"/>
        <Bug pattern="URF_UNREAD_FIELD,UUF_UNUSED_FIELD"/>
    </Match>
    <Match>
        <Class name="com.ucc.complaints.telegram.TelegramCryptoService"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW,REC_CATCH_EXCEPTION"/>
    </Match>
</FindBugsFilter>
